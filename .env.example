# PROTEGO — environment variables (names only; no real values, no secrets).
# Copy to .env.local (web) / .env (mobile) per app as each milestone needs it.
# M0 ships no auth/booking/payments/maps — these are documented ahead of when
# each is wired in, per docs/architecture/repository-audit.md.

# --- Supabase (M1) — project: tacnqewyrdaxexqcbxhz ---
# URL + anon key are not secret (safe to expose client-side); real values live
# in apps/web/.env.local and apps/mobile/.env.local (gitignored), kept name-only
# here per M0 acceptance test (.env.example never carries real values).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed client-side (CLAUDE.md: "no service-role key
# client-side"). Fill in locally; used only in apps/web route handlers /
# Edge Functions, never imported by client components.
SUPABASE_SERVICE_ROLE_KEY=
# Mobile (Expo) — EXPO_PUBLIC_* is the only prefix Expo inlines client-side.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe, manual capture (M5) — see repository-audit.md §4 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Maps, provider decision pending (M4) — see repository-audit.md §8.3 ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Sentry (MASTERPROMPT §2.5) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- App URLs ---
NEXT_PUBLIC_SITE_URL=
