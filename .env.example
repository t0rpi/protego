# PROTEGO — environment variables (names only; no real values, no secrets).
# Copy to .env.local (web) / .env (mobile) per app as each milestone needs it.
# M0 ships no auth/booking/payments/maps — these are documented ahead of when
# each is wired in, per docs/architecture/repository-audit.md.

# --- Supabase (M1+) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe, manual capture (M5) — see repository-audit.md §4 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Maps, provider decision pending (M4) — see repository-audit.md §8.3 ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Sentry (MASTERPROMPT §2.5) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- App URLs ---
NEXT_PUBLIC_SITE_URL=
EXPO_PUBLIC_API_URL=
