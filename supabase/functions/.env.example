# Local Edge Function secrets (names only — no real values). Copy to
# supabase/functions/.env (gitignored by the repo's blanket `.env` rule)
# for `supabase functions serve` during local development.
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are
# auto-injected by the Supabase CLI/platform at runtime — do NOT set
# them here, they don't need to be.
#
# For the DEPLOYED project, these are set via:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
