{
  "expo": {
    "name": "PROTEGO",
    "slug": "protego",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "protego",
    "userInterfaceStyle": "dark",
    "web": {
      "output": "static"
    },
    "android": {
      "package": "ro.protego.app"
    },
    "plugins": [
      "expo-router",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.ro.protego",
          "enableGooglePay": false
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "PROTEGO are nevoie de acces la galerie pentru fotografiile vehiculului.",
          "cameraPermission": "PROTEGO are nevoie de acces la cameră pentru fotografiile vehiculului."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db148458-12e8-4c79-84f5-ae811a053448"
      }
    },
    "owner": "torpi"
  }
}
